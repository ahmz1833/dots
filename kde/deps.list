klassy        cmake:KF6GuiAddons             cmake(KF6GuiAddons)             libkf6guiaddons-dev         kguiaddons
klassy        cmake:KF6I18n                  cmake(KF6I18n)                  libkf6i18n-dev              ki18n
klassy        cmake:KF6IconThemes            cmake(KF6IconThemes)            libkf6iconthemes-dev        kiconthemes
klassy        cmake:KF6KCMUtils              cmake(KF6KCMUtils)              libkf6kcmutils-dev          kcmutils
klassy        cmake:KF6WindowSystem          cmake(KF6WindowSystem)          libkf6windowsystem-dev      kwindowsystem
