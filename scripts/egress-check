    (
        "AI / Agents",
        "Google Gemini API",
        "https://generativelanguage.googleapis.com/v1beta/models?key=AIzaSyDummyKeyCheckForVetting",
        eval_gemini_api,
    ),
    ("AI / Agents", "Perplexity AI", "https://www.perplexity.ai", None),
    ("AI / Agents", "Hugging Face Hub", "https://huggingface.co/api/models?limit=1", None),
    ("AI / Agents", "OpenRouter API", "https://openrouter.ai/api/v1/models", None),
    ("AI / Agents", "GitHub API", "https://api.github.com/zen", None),

