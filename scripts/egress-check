    ("Social Media", "Discord API Gateway", "https://discord.com/api/v10/gateway", eval_discord),
    ("Social Media", "Telegram Bot API", "https://api.telegram.org", None),

    # Search, Cloud CDN & Streaming
    ("Search & Cloud", "Google Search (Captcha)", "https://www.google.com/search?q=linux+kernel&hl=en", eval_google_search),
    ("Search & Cloud", "YouTube", "https://www.youtube.com/robots.txt", None),
    ("Search & Cloud", "Cloudflare CDN", "https://www.cloudflare.com/cdn-cgi/trace", None),
    ("Search & Cloud", "Netflix Non-Originals", "https://www.netflix.com/title/81280792", eval_netflix),
]


def run_service_probes(family: socket.AddressFamily, timeout: float = 5.5) -> List[ServiceProbeResult]:
    def _worker(item: Tuple[str, str, str, Optional[Callable[[HTTPResponseData], Tuple[str, str]]]]) -> ServiceProbeResult:
        cat, name, url, evaluator = item
        resp = http_request(url, family=family, timeout=timeout)
        return _evaluate_probe(cat, name, url, resp, evaluator)

    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as pool:
        return list(pool.map(_worker, SERVICE_PROBES))


# ==============================================================================
# Phase 5: Per-Stack Cleanliness Scoring & Verdict
# ==============================================================================

@dataclass
class StackVerdict:
    stack: str
    available: bool
    score: int = 100
    verdict: str = "CLEAN"
    mail_verdict: str = "PORT25-BLOCKED"
    deductions: List[str] = field(default_factory=list)
    notes: List[str] = field(default_factory=list)
    identity: Optional[IdentityInfo] = None
    reputation: Optional[ReputationResult] = None
    mail: Optional[MailEgressReport] = None
    services: List[ServiceProbeResult] = field(default_factory=list)


def compute_stack_verdict(
    stack: str,
    identity: IdentityInfo,
    rep: ReputationResult,
    mail: MailEgressReport,
    services: List[ServiceProbeResult],
) -> StackVerdict:
    score = 100
    reasons: List[str] = []
    notes: List[str] = []

    # 1. DNSBL Penalties (Hard evidence of spam/abuse)
    if rep.dnsbl_listed:
        n = len(rep.dnsbl_listed)
        penalty = min(45, n * 15)
        score -= penalty
        names = ", ".join(d["zone"] for d in rep.dnsbl_listed[:4])
        reasons.append(f"-{penalty} pts: Listed on {n} DNSBL(s) ({names})")

    # 2. Fraud Scores & Threat Feeds
    if rep.sender_score is not None and rep.sender_score < 70:
        pen = 15 if rep.sender_score < 50 else 8
        score -= pen
        reasons.append(f"-{pen} pts: Low Validity SenderScore ({rep.sender_score}/100)")

    # For IPv6, Scamalytics often assigns 100 to entire unindexed datacenter /32s; cross-check with ProxyCheck & DNSBLs
    if rep.scamalytics_score is not None and rep.scamalytics_score >= 30:
        if stack == "IPv6" and rep.scamalytics_score == 100 and (rep.proxycheck_risk or 0) < 50 and not rep.dnsbl_listed:
            score -= 8
            reasons.append("-8 pts: Scamalytics scores IPv6 ASN range at 100/100 (ProxyCheck & DNSBLs are clean)")
        else:
            pen = 18 if rep.scamalytics_score >= 65 else 10
            score -= pen
            reasons.append(f"-{pen} pts: Scamalytics Fraud Score is {rep.scamalytics_score}/100 ({rep.scamalytics_risk})")

    if rep.proxycheck_risk is not None and rep.proxycheck_risk >= 50:
        pen = 15 if rep.proxycheck_risk >= 75 else 8
        score -= pen
        reasons.append(f"-{pen} pts: ProxyCheck.io Risk Score is {rep.proxycheck_risk}/100 ({rep.proxycheck_type})")

    if rep.stopforumspam_appears:
        score -= 15
        reasons.append(f"-15 pts: Listed in StopForumSpam ({rep.stopforumspam_frequency} abuse reports)")

    if rep.dshield_reports > 0:
        score -= 12
        reasons.append(f"-12 pts: SANS ISC DShield reports {rep.dshield_reports} attack packet logs from this IP")

    # Cross-validated Proxy/VPN detection across 4 DBs (IP-API, ipapi.is, ProxyCheck.io, Shodan)
    if identity.is_abuser or identity.is_tor:
        score -= 20
        reasons.append("-20 pts: Flagged as known abuser / Tor exit node by ipapi.is")
    elif len(identity.proxy_detections) >= 2:
        score -= 15
        reasons.append(f"-15 pts: Confirmed Proxy/VPN across {len(identity.proxy_detections)} DBs ({', '.join(identity.proxy_detections)})")
    elif len(identity.proxy_detections) == 1:
        score -= 5
        reasons.append(f"-5 pts: Flagged as Proxy/VPN by 1/4 DBs ({identity.proxy_detections[0]} — common for VPS hosting ASNs)")

    if rep.shodan_vulns:
        score -= 10
        reasons.append(f"-10 pts: Shodan InternetDB reports {len(rep.shodan_vulns)} CVE(s) on this IP")

    # 3. GeoIP Broadcast / Mismatch Penalty
    if not identity.geo_consistent:
        score -= 5
        src_str = ", ".join(f"{k}={v}" for k, v in identity.geo_sources.items())
        reasons.append(f"-5 pts: GeoIP Country Mismatch across DBs ({src_str})")

    # 4. Mail Server Reputation Rejections (Only penalize IP cleanliness if an MX actively rejected the IP;
    #    Port 25 firewall blocks & missing PTR are tracked in mail_verdict and notes)
    blocked_mx = [h.provider for h in mail.mx_handshakes if h.status == "BLOCKED"]
    if blocked_mx:
        pen = min(20, len(blocked_mx) * 8)
        score -= pen
        reasons.append(f"-{pen} pts: Actively rejected by MX server(s) on Port 25 ({', '.join(blocked_mx)})")

    if not mail.port_25_open:
        notes.append("Info: Outbound SMTP Port 25 is blocked by VPS firewall (standard on most clouds; tracked under Mail Readiness)")
    if not identity.ptr_record:
        notes.append("Info: No Reverse DNS (PTR) configured yet (set PTR in VPS panel if running a mail server)")

    # 5. Target Service Reachability Penalties (Separate IP/WAF Blocks from Regional Geo-Blocks)
    waf_blocked = [s.service for s in services if s.verdict in ("BLOCKED", "CAPTCHA")]
    geo_blocked = [s.service for s in services if s.verdict == "GEO-BLOCKED"]

    if waf_blocked:
        # Reddit blocks almost 95% of datacenter ASNs; weight 1 datacenter block lightly (-4 pts), multiple heavier
        pen = 4 if len(waf_blocked) == 1 else min(25, len(waf_blocked) * 5)
        score -= pen
        reasons.append(f"-{pen} pts: WAF/IP Blocked or Captcha on {len(waf_blocked)} service(s) ({', '.join(waf_blocked[:4])})")

    if geo_blocked:
        notes.append(f"Region Policy: {len(geo_blocked)} service(s) Geo-Blocked in this country ({', '.join(geo_blocked)})")

    score = max(0, score)
    if score >= 80 and len(rep.dnsbl_listed) == 0:
        verdict = "CLEAN"
    elif score >= 55:
        verdict = "WARN"
    else:
        verdict = "DIRTY"

    return StackVerdict(
        stack=stack,
        available=True,
        score=score,
        verdict=verdict,
        mail_verdict=mail.mail_readiness,
        deductions=reasons,
        notes=notes,
        identity=identity,
        reputation=rep,
        mail=mail,
        services=services,
    )


# ==============================================================================
# Pretty Terminal Report Printer
# ==============================================================================

def print_stack_report(sv: StackVerdict) -> None:
    print(f"\n{Style.BOLD}{Style.CYAN}============================================================================={Style.RESET}")
    if not sv.available or not sv.identity or not sv.identity.ip:
        print(f" {Style.BOLD}{sv.stack} STACK:{Style.RESET} {badge('UNAVAILABLE')} (No {sv.stack} egress route detected on this VM)")
        print(f"{Style.BOLD}{Style.CYAN}============================================================================={Style.RESET}")
        return

    ident = sv.identity
    rep = sv.reputation
    mail = sv.mail

    print(
        f" {Style.BOLD}{sv.stack} STACK REPORT{Style.RESET} — Egress IP: {Style.BOLD}{ident.ip}{Style.RESET}\n"
        f" IP Cleanliness: {Style.BOLD}{sv.score}/100{Style.RESET} {badge(sv.verdict)} "
        f"| Mail Egress Readiness: {badge(sv.mail_verdict)}"
    )
    print(f"{Style.BOLD}{Style.CYAN}============================================================================={Style.RESET}")

    # Section 1: Identity & Network
    print(f"\n{Style.BOLD}1. Egress Identity, GeoIP Consistency & Reverse DNS{Style.RESET}")
    print(f"   • ASN / ISP      : {ident.asn} ({ident.isp})")
    print(f"   • Organization   : {ident.org} (ASN Abuser Score: {ident.abuser_score})")
    print(f"   • Geo Location   : {ident.city}, {ident.region}, {ident.country}")
    geo_map_str = " | ".join(f"{k}:{v}" for k, v in ident.geo_sources.items()) or "Unknown"
    geo_badge = badge("CONSISTENT" if ident.geo_consistent else "MISMATCH")
    print(f"   • GeoIP DB Check : {geo_badge} ({geo_map_str}) [Edge Colo: {ident.cf_colo}, TLS: {ident.cf_tls}]")

    if len(ident.proxy_detections) == 0:
        proxy_badge = badge("CLEAN") + " (0/4 DBs)"
    elif len(ident.proxy_detections) == 1:
        proxy_badge = badge("1/4 DBS") + f" ({ident.proxy_detections[0]} only)"
    else:
        proxy_badge = badge("DIRTY") + f" ({', '.join(ident.proxy_detections)})"

    flags = [
        f"Hosting/DC={badge('YES' if ident.is_hosting else 'NO')}",
        f"Proxy/VPN={proxy_badge}",
        f"Tor={badge('DIRTY' if ident.is_tor else 'CLEAN')}",
        f"Abuser={badge('DIRTY' if ident.is_abuser else 'CLEAN')}",
    ]
    print(f"   • Network Flags  : {', '.join(flags)}")
    print(
        f"   • Reverse DNS    : {ident.ptr_record or 'None'} "
        f"| FCrDNS: {badge('PASS' if ident.fcrdns_valid else 'FAIL')} "
        f"| Type: {badge('GENERIC-PTR' if ident.generic_ptr else ('CUSTOM' if ident.ptr_record else 'MISSING'))}"
    )

    # Section 2: Online Reputation & Blacklists
    if rep:
        print(f"\n{Style.BOLD}2. Online Reputation DBs, IP Scores & Blacklists (DNSBLs){Style.RESET}")
        ss_str = f"{rep.sender_score}/100" if rep.sender_score is not None else "Unscored (Low mail volume)"
        scam_str = (
            f"{rep.scamalytics_score}/100 {badge(rep.scamalytics_risk)}"
            if rep.scamalytics_score is not None
            else "N/A"
        )
        pcheck_str = (
            f"Risk={rep.proxycheck_risk}/100 | Type={rep.proxycheck_type} | Proxy={badge('DIRTY' if rep.proxycheck_proxy else 'CLEAN')}"
            if rep.proxycheck_risk is not None
            else "N/A"
        )
        sfs_str = (
            f"{badge('LISTED')} ({rep.stopforumspam_frequency} reports)"
            if rep.stopforumspam_appears
            else f"{badge('CLEAN')} (0 reports)"
        )
        dshield_str = (
            f"{badge('LISTED')} ({rep.dshield_reports} reports / {rep.dshield_attacks} targets)"
            if rep.dshield_reports > 0
            else f"{badge('CLEAN')} (0 attack reports)"
        )
        print(f"   • Validity SenderScore    : {ss_str} | Mailspike Rep: {rep.mailspike_rep}")
        print(f"   • Scamalytics Fraud Score : {scam_str}")
        print(f"   • ProxyCheck.io Score     : {pcheck_str}")
        print(f"   • StopForumSpam & DShield : SFS={sfs_str} | SANS DShield={dshield_str}")
        ports_str = ", ".join(map(str, rep.shodan_open_ports)) if rep.shodan_open_ports else "None indexed"
        vulns_str = ", ".join(rep.shodan_vulns) if rep.shodan_vulns else "None"
        tags_str = ", ".join(rep.shodan_tags) if rep.shodan_tags else "None"
        print(f"   • Shodan InternetDB       : Open Ports=[{ports_str}] | CVEs=[{vulns_str}] | Tags=[{tags_str}]")

        if rep.dnsbl_listed:
            print(f"   • DNSBL Status            : {badge('LISTED')} on {len(rep.dnsbl_listed)}/{rep.dnsbl_total_checked} blacklists:")
            for item in rep.dnsbl_listed:
                print(f"       - {Style.RED}✗ {item['name']} ({item['zone']}) -> {item['return_code']}{Style.RESET}")
        else:
            print(f"   • DNSBL Status            : {badge('CLEAN')} (0/{rep.dnsbl_total_checked} blacklists triggered)")

    # Section 3: Mail Egress & MX Handshakes
    if mail:
        print(f"\n{Style.BOLD}3. Mail Server Readiness & Outbound SMTP Egress{Style.RESET}")
        p25 = badge("OPEN" if mail.port_25_open else "BLOCKED")
        p465 = badge("OPEN" if mail.port_465_open else "BLOCKED")
        p587 = badge("OPEN" if mail.port_587_open else "BLOCKED")
        print(f"   • Outbound Mail Ports     : Port 25 (MX Relay)={p25} | Port 465 (SMTPS)={p465} | Port 587 (Submission)={p587}")
        print(f"   • Live MX Server Port 25 Handshakes:")
        for h in mail.mx_handshakes:
            print(
                f"       - {h.provider:<24} ({h.mx_host:<38}): "
                f"{badge(h.status)} [{h.code}] ({h.elapsed_ms:.0f}ms) {Style.DIM}{h.banner[:65]}{Style.RESET}"
            )

        if mail.domain_check:
            dc = mail.domain_check
            print(f"   • Domain Alignment ({dc['domain']}):")
            print(f"       - MX Records  : {', '.join(dc['mx_records']) or 'None'}")
            print(f"       - SPF Record  : {dc['spf_record'] or 'Missing'}")
            print(f"       - DMARC Record: {dc['dmarc_record'] or 'Missing'}")
            print(f"       - IP in SPF   : {badge('PASS' if dc['ip_literally_in_spf'] else 'WARN')}")

    # Section 4: Target Services Probe
    if sv.services:
        print(f"\n{Style.BOLD}4. Target Services Reachability (AI/Agents, Social Media, Search & Streaming){Style.RESET}")
        print(f"   {'Category':<15} {'Service':<24} {'Status':<16} {'HTTP':<6} {'Latency':<9} {'Details'}")
        print(f"   {'-'*14:<15} {'-'*23:<24} {'-'*14:<16} {'-'*5:<6} {'-'*8:<9} {'-'*34}")
        for s in sv.services:
            print(
                f"   {s.category:<15} {s.service:<24} {badge(s.verdict):<25} "
                f"{str(s.http_status):<6} {f'{s.elapsed_ms:.0f}ms':<9} {s.detail}"
            )

    # Section 5: Score Breakdown & Notes
    if sv.deductions or sv.notes:
        print(f"\n{Style.BOLD}5. Score Breakdown & Operational Notes ({sv.stack}){Style.RESET}")
        for d in sv.deductions:
            print(f"   • {Style.YELLOW}{d}{Style.RESET}")
        for n in sv.notes:
            print(f"   • {Style.CYAN}{n}{Style.RESET}")


# ==============================================================================
# Main Entrypoint
# ==============================================================================

def vet_single_stack(
    family: socket.AddressFamily,
    mail_domain: Optional[str],
    timeout: float,
) -> StackVerdict:
    stack_name = "IPv4" if family == socket.AF_INET else "IPv6"
    ident = check_identity_and_rdns(family, timeout=timeout)
    if not ident.ip:
        return StackVerdict(stack=stack_name, available=False, score=0, verdict="UNAVAILABLE")

    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        f_rep = pool.submit(check_online_reputation, ident.ip, family, ident, timeout)
        f_mail = pool.submit(check_mail_egress, ident, family, mail_domain, timeout)
        f_svc = pool.submit(run_service_probes, family, timeout)

        rep = f_rep.result()
        mail = f_mail.result()
        svcs = f_svc.result()

    return compute_stack_verdict(stack_name, ident, rep, mail, svcs)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Zero-dependency Dual-Stack (IPv4 & IPv6) VM Egress & IP Reputation Vetter (v2.0)"
    )
    parser.add_argument("--ipv4-only", action="store_true", help="Only vet IPv4 egress")
    parser.add_argument("--ipv6-only", action="store_true", help="Only vet IPv6 egress")
    parser.add_argument("--mail-domain", type=str, default=None, help="Optional domain to verify MX/SPF/DMARC alignment")
    parser.add_argument("--timeout", type=float, default=5.5, help="Per-request socket timeout in seconds (default: 5.5)")
    parser.add_argument("--json", type=str, default=None, metavar="FILE", help="Write full JSON report to FILE (use '-' for stdout)")
    args = parser.parse_args()

    families: List[socket.AddressFamily] = []
    if args.ipv4_only:
        families = [socket.AF_INET]
    elif args.ipv6_only:
        families = [socket.AF_INET6]
    else:
        families = [socket.AF_INET, socket.AF_INET6]

    if args.json != "-":
        print(f"{Style.BOLD}Starting Dual-Stack VM Egress, Mail & IP Reputation Vetting (v2.0)...{Style.RESET}")

    results: Dict[str, StackVerdict] = {}
    for fam in families:
        sv = vet_single_stack(fam, mail_domain=args.mail_domain, timeout=args.timeout)
        results[sv.stack] = sv
        if args.json != "-":
            print_stack_report(sv)

    # Final Summary Table
    if args.json != "-":
        print(f"\n{Style.BOLD}OVERALL VM EGRESS SUMMARY{Style.RESET}")
        for stack_name, sv in results.items():
            if not sv.available or not sv.identity or not sv.identity.ip:
                print(f"  • {stack_name:<5}: {badge('UNAVAILABLE')}")
            else:
                print(
                    f"  • {stack_name:<5}: {sv.identity.ip:<39} -> "
                    f"IP Score: {Style.BOLD}{sv.score}/100{Style.RESET} {badge(sv.verdict)} | "
                    f"Mail: {badge(sv.mail_verdict)}"
                )
        print()

    if args.json:
        payload = {
            "timestamp_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "stacks": {k: asdict(v) for k, v in results.items()},
        }
        json_text = json.dumps(payload, indent=2)
        if args.json == "-":
            print(json_text)
        else:
            with open(args.json, "w", encoding="utf-8") as f:
                f.write(json_text + "\n")
            print(f"Saved JSON report to {args.json}")

    any_dirty = any(sv.available and sv.verdict == "DIRTY" for sv in results.values())
    return 2 if any_dirty else 0


if __name__ == "__main__":
    sys.exit(main())